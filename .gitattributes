###############################################################################
# ForgeFlow AI - Git Attributes
###############################################################################

# Automatically detect text files and normalize line endings
* text=auto

# Source Code
*.java      text
*.kt        text
*.groovy    text
*.xml       text
*.yml       text
*.yaml      text
*.json      text
*.properties text
*.sql       text
*.sh        text eol=lf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Frontend
*.ts        text
*.tsx       text
*.js        text
*.jsx       text
*.css       text
*.scss      text
*.html      text

# Documentation
*.md        text
*.txt       text

# Docker
Dockerfile  text eol=lf
*.dockerfile text eol=lf
*.env.example text

# Binary files
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.jar       binary
*.war       binary
*.mp4       binary
*.mp3       binary
*.wav       binary
