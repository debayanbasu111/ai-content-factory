# =========================
# APPLICATION CONFIG
# =========================
APP_NAME=ai-content-factory
APP_ENV=local
SERVER_PORT=8080

# =========================
# FRONTEND CONFIG (React)
# =========================
REACT_APP_API_BASE_URL=http://localhost:8080/api
REACT_APP_AZURE_AD_CLIENT_ID=your-client-id
REACT_APP_AZURE_AD_TENANT_ID=your-tenant-id
REACT_APP_REDIRECT_URI=http://localhost:3000/auth/callback

# =========================
# AUTH (Azure AD / Entra ID)
# =========================
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_AUTHORITY=https://login.microsoftonline.com/your-tenant-id
AZURE_AD_SCOPE=openid profile email

# =========================
# AWS CONFIG (ECS + IAM)
# =========================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/your-ecs-role

# If using ECS Task Role (recommended)
USE_IAM_ROLE=true

# =========================
# REDSHIFT DATA API
# =========================
REDSHIFT_DATABASE=dev
REDSHIFT_CLUSTER_ID=your-cluster-id
REDSHIFT_WORKGROUP_NAME=your-workgroup-name
REDSHIFT_SCHEMA=public
REDSHIFT_SECRET_ARN=your-secret-arn

# Query behavior tuning
REDSHIFT_MAX_RETRIES=3
REDSHIFT_POLL_INTERVAL_MS=2000

# =========================
# DATABASE (if any internal DB used)
# =========================
DB_URL=jdbc:postgresql://localhost:5432/contentdb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# =========================
# SECURITY / JWT (if used internally)
# =========================
JWT_SECRET=your-jwt-secret
JWT_EXPIRY_MS=3600000

# =========================
# LOGGING
# =========================
LOG_LEVEL=INFO

# =========================
# FEATURE FLAGS
# =========================
ENABLE_AUTO_POLLING=true
ENABLE_AUDIT_LOGS=true
ENABLE_AI_GENERATION=false

# =========================
# EXTERNAL SERVICES (future extension)
# =========================
OPENAI_API_KEY=your-openai-key
